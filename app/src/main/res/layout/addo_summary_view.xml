<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:background="@color/addo_primary"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:id="@+id/summary_titles">

        <TextView
            android:layout_height="wrap_content"
            android:layout_width="0dp"
            android:id="@+id/tot_ref"
            style="@style/askTheClientIfTh"
            android:gravity="center"
            android:layout_margin="5dp"
            android:text="@string/total_referrals"
            android:textColor="@color/white"
            android:fontFamily="@font/google_sans_regular"
            android:textSize="13sp"
            android:layout_weight="1"/>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/grey"/>

        <TextView
            android:id="@+id/ref_closure"
            style="@style/askTheClientIfTh"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:layout_margin="5dp"
            android:textColor="@color/white"
            android:text="@string/referrals_closed"
            android:fontFamily="@font/google_sans_regular"
            android:textSize="13sp"/>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/grey"/>

        <TextView
            android:id="@+id/num_visits"
            style="@style/askTheClientIfTh"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:layout_margin="5dp"
            android:textColor="@color/white"
            android:text="@string/total_visits"
            android:fontFamily="@font/google_sans_regular"
            android:textSize="13sp"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="8dp"
        android:gravity="center_vertical"
        android:id="@+id/summary_values">

        <TextView
            android:id="@+id/tot_ref_num"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:fontFamily="@font/google_sans_bold"
            android:text="10"
            android:textSize="20sp"
            android:textColor="@color/white"
            android:layout_weight="1"/>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/grey"/>

        <TextView
            android:id="@+id/ref_closure_num"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="20sp"
            android:textColor="@color/white"
            android:fontFamily="@font/google_sans_bold"
            android:text="6"
            android:layout_weight="1" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/grey"/>

        <TextView
            android:id="@+id/num_visits_nums"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="20sp"
            android:textColor="@color/white"
            android:fontFamily="@font/google_sans_bold"
            android:text="34"
            android:layout_weight="1" />

    </LinearLayout>

</LinearLayout>