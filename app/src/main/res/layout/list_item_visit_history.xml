<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/visit_date_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:text="@string/visit_date"
            android:fontFamily="@font/google_sans_bold"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/visit_date_textview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/google_sans_medium"
            android:textColor="#262626" />

    </LinearLayout>

    <!--  A horizontal linear layout with key: "Medicine Dispensed" and the value as the visit_details_textview  -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/visit_key_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:fontFamily="@font/google_sans_bold"
            android:text="@string/medicine_dispensed"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/visit_details_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:fontFamily="@font/google_sans_medium"
            android:textColor="#262626"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</LinearLayout>
