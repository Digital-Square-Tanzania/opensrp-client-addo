<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:id="@+id/record_visit"
    android:orientation="vertical"
    android:paddingTop="10dp">

    <LinearLayout
        android:id="@+id/record_visit_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="10dp"
        android:visibility="visible"
        android:orientation="vertical">

        <org.smartregister.view.customcontrols.CustomFontTextView
            android:id="@+id/textview_ds_screening"
            style="@style/CustomFontTextViewStyle.ListView.Normal.MultipleLines"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/addo_btn_selector_client_profile"
            android:gravity="center_horizontal"
            android:paddingLeft="30dp"
            android:paddingTop="10dp"
            android:paddingRight="30dp"
            android:paddingBottom="10dp"
            android:text="@string/addo_non_focus_profile_action_text"
            android:textColor="@color/addo_primary"
            android:textStyle="bold" />

        <org.smartregister.view.customcontrols.CustomFontTextView
            android:id="@+id/non_focused_client_medicine_dispense"
            style="@style/CustomFontTextViewStyle.ListView.Normal.MultipleLines"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:background="@drawable/addo_btn_selector_client_profile"
            android:gravity="center"
            android:visibility="gone"
            android:text="@string/non_focused_client_medicine_dispense_text"
            android:textAllCaps="false"
            android:textColor="@color/addo_primary" />

    </LinearLayout>

</LinearLayout>